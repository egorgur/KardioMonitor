# Скопируйте в .env (он не коммитится) и поменяйте значения.

# База демо-прототипа — SQLite-файл рядом с сервером (ADR-0007)
KARDIO_DATABASE_URL=sqlite+aiosqlite:///./kardio.db

# Ключ панели клиники: без него панель по ссылке ngrok открыта всем.
# Открывайте панель как https://<адрес-ngrok>/?key=<ключ>
KARDIO_DASHBOARD_KEY=

# Собранная панель (cd ../frontend && npm run build)
KARDIO_FRONTEND_DIST=../frontend/dist
