# Скопируйте в .env (он не коммитится) и поменяйте значения.

# База демо-прототипа — SQLite-файл рядом с сервером (ADR-0007)
KARDIO_DATABASE_URL=sqlite+aiosqlite:///./kardio.db

# Cookie сеанса врача только по HTTPS (ADR-0011). ngrok и localhost подходят;
# false — только для разработки по HTTP на другом адресе.
KARDIO_SECURE_COOKIES=true

# Собранная панель (cd ../frontend && npm run build)
KARDIO_FRONTEND_DIST=../frontend/dist

# Дневные оповещения (ТР-08): проверка раз в минуту в процессе сервера (ADR-0009)
KARDIO_PERIODIC_CHECKS=true
